        {
          "id": "check_health",
          "sourceId": "aurem_api",
          "operationId": "health_api_health_get"
        }
      ],
      "fields": {
        "parameters": [],
        "responses": {
          "success": {
            "type": "object"
          }
        }
      }
    },
    {
