{
  "agentsJson": "0.1.0",
  "info": {
    "title": "ORA by Aurem",
    "version": "1.0.0",
    "description": "ORA is an autonomous AI software engineer that reads a GitHub repository and ships code to it."
  },
  "sources": [
    {
      "id": "aurem_api",
      "path": "https://auremcto.com/openapi.json",
      "description": "OpenAPI 3.1 document for the ORA REST API (projects, tasks, billing)."
    }
  ],
  "flows": [
    {
      "id": "check_health_flow",
      "title": "Check API health",
      "description": "Check that the ORA API is up and read its deploy identity.",
