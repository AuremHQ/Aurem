                {"path": "pages/index.tsx",   "type": "blob"},
                {"path": "README.md",         "type": "blob"},
            ], False
        monkeypatch.setattr(orch, "_fetch_tree", fake_tree)
    
        # 3. _fetch_file returns small HTML for the two HTML paths,
