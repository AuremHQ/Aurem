            "user_id":       "u_test",
            "github_owner":  "tiangolo",
            "github_repo":   "fastapi",
            "branch":        "master",
            "github_token":  "fake",
        })
        monkeypatch.setattr(orch, "get_db", lambda: fake_db)
    
        # 2. _fetch_tree returns a small simulated repo.
