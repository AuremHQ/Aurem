                        fields["error_plain"]      = friendly.get("plain") or ""
                        fields["error_steps"]      = friendly.get("steps") or []
                        fields["error_suggestion"] = friendly.get("suggestion") or ""
                        fields["error_source"]     = friendly.get("source") or "unknown"
