        for f in findings:
            assert "package" in f
            assert "id" in f
            assert "severity" in f
            assert "source" in f and f["source"] == "yarn"
            assert f["severity"] in {"INFO", "LOW", "MODERATE",
                                     "HIGH", "CRITICAL", ""}, f
        # Deduplication proof — no two findings share the same primary id
        ids = [f["id"] for f in findings]
