# Trufflehog exclude patterns — paths inside this repo that contain
# intentionally fake secrets (tests, fixtures, docs).  One regex per
# line; matches relative file paths.
#
# IMPORTANT: --exclude-paths makes the main scan SKIP these files entirely
# (it does not merely filter unverified noise). A separate CI step,
# "Fail on verified secrets in excluded paths", re-scans exactly these paths
# with --only-verified and fails the job on any verified hit.
^backend/tests/
^frontend/src/__tests__/
^frontend/__tests__/
^backend/scripts/.*\.sample$
^docs/
\.md$
\.lock$
yarn\.lock
package-lock\.json
\.snap$
